# Python
__pycache__/
*.pyc
*.egg-info/

# Allen API / atlas download raw response cache (regenerable via the fetch/build scripts)
mouse/data/cache/
human/data/cache/

# third-party repo clone, not part of this project
external/brainglobe-atlasapi/

# Claude Code local runtime state, not project content
.claude/

# Cloudflare Wrangler local cache/account state, not project content
.wrangler/

# Assembled hub site: the hub page plus a copy of every viewer (~43MB of
